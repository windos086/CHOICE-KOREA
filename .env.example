# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# KAKAO LOGIN: 카카오 디벨로퍼스에서 발급받은 실제 키들 
# (VITE_KAKAO_JAVASCRIPT_KEY/VITE_KAKAO_JS_KEY는 클라이언트 모달용, KAKAO_REST_API_KEY는 서버측 토큰 교환용으로 둘 중 하나만 입력하거나 둘 다 올바르게 입력해주시면 됩니다.)
VITE_KAKAO_JAVASCRIPT_KEY=""
VITE_KAKAO_JS_KEY=""
KAKAO_REST_API_KEY=""

# GOOGLE LOGIN (WEBVIEW STORAGE PORTITION DEFENSE / PRODUCTION BACKEND OAUTH)
# (구글 클라우드 콘솔 -> API 및 서비스 -> 사용자 인증 정보에서 웹 애플리케이션용으로 발급받아 환경 변수에 등록 시 완벽한 인앱브라우저 로그인이 실현됩니다.)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# BACKEND / GITHUB BINDINGS
VITE_GEMINI_API_KEY=""
